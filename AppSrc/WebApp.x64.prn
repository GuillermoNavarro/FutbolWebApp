36878>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36879>>>>>    
36879>>>>>    Procedure Construct_Object
36881>>>>>        Handle hoObj
36881>>>>>        
36881>>>>>        Forward Send Construct_Object
36883>>>>>        
36883>>>>>        Set pbSessionCookieHttpOnly to True
36884>>>>>        
36884>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36885>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36886>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36887>>>>>        
36887>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36888>>>>>        Set phoUserDD to hoObj
36889>>>>>        
36889>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36890>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36891>>>>>        Set phoSessionDD to hoObj
36892>>>>>        
36892>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36893>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36894>>>>>        Set phoCrypto to hoObj
36895>>>>>        
36895>>>>>        Property Boolean pbPasswordHashing True
36896>>>>>        
36896>>>>>        Property Boolean pbCreatingNewSession False
36897>>>>>        Property String psLoginName
36898>>>>>        Property String psUserName ""
36899>>>>>        Property Integer piUserRights 0
36900>>>>>    End_Procedure
36901>>>>>    
36901>>>>>    Procedure End_Construct_Object
36903>>>>>        Forward Send End_Construct_Object
36905>>>>>        
36905>>>>>        Handle hoCrypto
36905>>>>>        Integer iFieldLen
36905>>>>>        If (pbPasswordHashing(Self)) Begin
36907>>>>>            Get phoCrypto to hoCrypto
36908>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36911>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36913>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36914>>>>>>
36914>>>>>            End
36914>>>>>>
36914>>>>>        End
36914>>>>>>
36914>>>>>    End_Procedure
36915>>>>>    
36915>>>>>    Function CreateSession String sRemoteAddress Returns String
36917>>>>>        String sSessionKey
36917>>>>>        Integer iErr
36917>>>>>        Boolean bLogWebSession
36917>>>>>        Handle hoSessionDD       
36917>>>>>        Get phoSessionDD to hoSessionDD
36918>>>>>        
36918>>>>>        //  Get session key
36918>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36920>>>>>        
36920>>>>>        Get pbLogWebSession to bLogWebSession
36921>>>>>        If not bLogWebSession Begin
36923>>>>>            Function_Return sSessionKey        
36924>>>>>        End
36924>>>>>>
36924>>>>>
36924>>>>>        //  Store session
36924>>>>>        Send Clear of hoSessionDD
36925>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36926>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36927>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36928>>>>>        Get Request_Validate of hoSessionDD to iErr
36929>>>>>        If (iErr) Begin
36931>>>>>            // this should not happen. If it does its a programming error
36931>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36932>>>>>>
36932>>>>>            Function_Return ""
36933>>>>>        End
36933>>>>>>
36933>>>>>        Send Request_Save of hoSessionDD
36934>>>>>        If (Err) Begin
36936>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36936>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36937>>>>>>
36937>>>>>            Function_Return ""
36938>>>>>        End
36938>>>>>>
36938>>>>>       
36938>>>>>        Function_Return sSessionKey        
36939>>>>>    End_Function
36940>>>>>    
36940>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36942>>>>>        DateTime dtLastAccess dtCurrent
36942>>>>>        TimeSpan tsDiff
36942>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36942>>>>>        Boolean bResult bCreatingNewSession
36942>>>>>        Boolean bLogWebSession bLoadWebApp
36942>>>>>        Integer eLoginMode
36942>>>>>        String sTime
36942>>>>>        Handle hoSessionDD hoUserDD       
36942>>>>>        
36942>>>>>        Move False to bLoadWebApp
36943>>>>>        If (num_arguments >= 2) Begin
36945>>>>>            Move bOptLoadWebApp to bLoadWebApp
36946>>>>>        End
36946>>>>>>
36946>>>>>        
36946>>>>>        Get phoSessionDD to hoSessionDD
36947>>>>>        Get phoUserDD to hoUserDD
36948>>>>>        
36948>>>>>        Get pbLogWebSession to bLogWebSession
36949>>>>>        Get peLoginMode to eLoginMode
36950>>>>>        
36950>>>>>        // for this object, you can only disable logging if login completely is disabled
36950>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36952>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36953>>>>>>
36953>>>>>            Function_Return False
36954>>>>>        End
36954>>>>>>
36954>>>>>
36954>>>>>        //  Clear session properties
36954>>>>>        Set psSessionKey to ""
36955>>>>>        Send UpdateSessionProperties True
36956>>>>>        
36956>>>>>        If not bLogWebSession Begin
36958>>>>>            Forward Get ValidateSession sSessionKey to bResult
36960>>>>>            Function_Return bResult
36961>>>>>        End        
36961>>>>>>
36961>>>>>        
36961>>>>>        Move False to bResult
36962>>>>>        Get piSessionTimeout to iSessionTimeout 
36963>>>>>        
36963>>>>>        //  Check if session exists
36963>>>>>        Send Clear of hoSessionDD
36964>>>>>        Move sSessionKey to WebAppSession.SessionKey
36965>>>>>        Send Find of hoSessionDD EQ Index.1
36966>>>>>            
36966>>>>>        If (Found) Begin
36968>>>>>            //  Calculate timespan between now and last access time
36968>>>>>            Move (CurrentDateTime()) to dtCurrent
36969>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36970>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36971>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36972>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36973>>>>>            
36973>>>>>            //  Check if session didn't time out
36973>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36975>>>>>                Forward Get ValidateSession sSessionKey to bResult
36977>>>>>                   
36977>>>>>                If (bResult) Begin
36979>>>>>                    //  Update session record
36979>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36980>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36981>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36982>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36983>>>>>                    Get Request_Validate of hoSessionDD to iErr
36984>>>>>                    If (iErr) Begin
36986>>>>>                        // this should not happen. If it does its a programming error
36986>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36987>>>>>>
36987>>>>>                        Function_Return False
36988>>>>>                    End
36988>>>>>>
36988>>>>>                    Send Request_Save of hoSessionDD
36989>>>>>                    
36989>>>>>                    //  Update user properties
36989>>>>>                    Send UpdateSessionProperties False
36990>>>>>                End
36990>>>>>>
36990>>>>>            End
36990>>>>>>
36990>>>>>            Else Begin
36991>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36991>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36992>>>>>                
36992>>>>>                If (not(bCreatingNewSession)) Begin
36994>>>>>                    If (not(bLoadWebApp)) Begin
36996>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36997>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36998>>>>>>
36998>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36999>>>>>                    End
36999>>>>>>
36999>>>>>                    Else Begin
37000>>>>>                        Set pbCreatingNewSession to True                    
37001>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37002>>>>>                        Set pbCreatingNewSession to False                        
37003>>>>>                    End
37003>>>>>>
37003>>>>>                End
37003>>>>>>
37003>>>>>            End
37003>>>>>>
37003>>>>>        End
37003>>>>>>
37003>>>>>        Else Begin
37004>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37005>>>>>>
37005>>>>>        End
37005>>>>>>
37005>>>>>        
37005>>>>>        Function_Return bResult
37006>>>>>    End_Function
37007>>>>>    
37007>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37009>>>>>        If (not(pbPasswordHashing(Self))) Begin
37011>>>>>            Move sPassword to sHash
37012>>>>>            Function_Return True
37013>>>>>        End
37013>>>>>>
37013>>>>>        
37013>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37015>>>>>            Function_Return False
37016>>>>>        End
37016>>>>>>
37016>>>>>        Move ("V1$" + sHash) to sHash
37017>>>>>        Function_Return True
37018>>>>>    End_Function
37019>>>>>    
37019>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37021>>>>>        If (not(pbPasswordHashing(Self))) Begin
37023>>>>>            Move False to bShouldUpgrade
37024>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37025>>>>>        End
37025>>>>>>
37025>>>>>        
37025>>>>>        String sVersion
37025>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37026>>>>>        If (sVersion = "V1$") Begin
37028>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37031>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37032>>>>>        End
37032>>>>>>
37032>>>>>        Else Begin
37033>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37036>>>>>            Function_Return False
37037>>>>>        End
37037>>>>>>
37037>>>>>    End_Function
37038>>>>>    
37038>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37040>>>>>        Handle hoUserDD
37040>>>>>        Integer iErr
37040>>>>>        Get phoUserDD to hoUserDD
37041>>>>>        
37041>>>>>        //  Find the user
37041>>>>>        Send Clear of hoUserDD
37042>>>>>        Move sLoginName to WebAppUser.LoginName
37043>>>>>        Send Find of hoUserDD EQ Index.1
37044>>>>>        If (Found) Begin
37046>>>>>            Send Clear of hoUserDD
37047>>>>>            Function_Return False
37048>>>>>        End
37048>>>>>>
37048>>>>>        
37048>>>>>        Send Clear of hoUserDD
37049>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37050>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37051>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37053>>>>>            Send Clear of hoUserDD
37054>>>>>            Function_Return False
37055>>>>>        End
37055>>>>>>
37055>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37056>>>>>        Get Request_Validate of hoUserDD to iErr
37057>>>>>        If (iErr) Begin
37059>>>>>            Send Clear of hoUserDD
37060>>>>>            Function_Return False
37061>>>>>        End
37061>>>>>>
37061>>>>>        
37061>>>>>        Send Request_Save of hoUserDD
37062>>>>>        Function_Return (not(Err))
37063>>>>>    End_Function
37064>>>>>    
37064>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37066>>>>>        String sSessionKey sUserPassword
37066>>>>>        Handle hoSessionDD hoUserDD
37066>>>>>        Boolean bMatch bUpgrade
37066>>>>>        
37066>>>>>        Get phoSessionDD to hoSessionDD
37067>>>>>        Get phoUserDD to hoUserDD
37068>>>>>        Integer iErr eLoginMode
37068>>>>>        
37068>>>>>        // Refind session record
37068>>>>>        Get psSessionKey to sSessionKey
37069>>>>>        Send Clear of hoSessionDD
37070>>>>>        Move sSessionKey to WebAppSession.SessionKey
37071>>>>>        Send Find of hoSessionDD EQ Index.1
37072>>>>>        
37072>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37074>>>>>            Get peLoginMode to eLoginMode
37075>>>>>            
37075>>>>>            //  Find the user
37075>>>>>            Move sLoginName to WebAppUser.LoginName
37076>>>>>            Send Find of hoUserDD EQ Index.1
37077>>>>>            
37077>>>>>            // Check username and password
37077>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37079>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37080>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37081>>>>>                
37081>>>>>                If (bMatch) Begin
37083>>>>>                    // Store the login
37083>>>>>                    If (bUpgrade) Begin
37085>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37086>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37089>>>>>                    End
37089>>>>>>
37089>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37090>>>>>                    Get Request_Validate of hoSessionDD to iErr
37091>>>>>                    If (iErr) Begin
37093>>>>>                        // this should not happen. If it does its a programming error
37093>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37094>>>>>>
37094>>>>>                        Function_Return False
37095>>>>>                    End
37095>>>>>>
37095>>>>>                    
37095>>>>>                    Send Request_Save of hoSessionDD
37096>>>>>                    
37096>>>>>                    // Update session properties
37096>>>>>                    Send UpdateSessionProperties False
37097>>>>>                    Send NotifyChangeRights
37098>>>>>                    Function_Return True
37099>>>>>                End
37099>>>>>>
37099>>>>>                Else Begin
37100>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37100>>>>>                    Send Clear of hoUserDD
37101>>>>>                End
37101>>>>>>
37101>>>>>            End
37101>>>>>>
37101>>>>>            Else Begin
37102>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37102>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37103>>>>>            End
37103>>>>>>
37103>>>>>        End
37103>>>>>>
37103>>>>>        Else Begin
37104>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37104>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37105>>>>>        End
37105>>>>>>
37105>>>>>          
37105>>>>>        Function_Return False
37106>>>>>    End_Function
37107>>>>>    
37107>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37109>>>>>        Handle hoUserDD
37109>>>>>        Integer iErr
37109>>>>>        Get phoUserDD to hoUserDD
37110>>>>>        
37110>>>>>        //  Find the user
37110>>>>>        Send Clear of hoUserDD
37111>>>>>        Move sLoginName to WebAppUser.LoginName
37112>>>>>        Send Find of hoUserDD EQ Index.1
37113>>>>>        If (not(Found)) Begin
37115>>>>>            Send Clear of hoUserDD
37116>>>>>            Function_Return False
37117>>>>>        End
37117>>>>>>
37117>>>>>        
37117>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37119>>>>>            Send Clear of hoUserDD
37120>>>>>            Function_Return False
37121>>>>>        End
37121>>>>>>
37121>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37122>>>>>        Get Request_Validate of hoUserDD to iErr
37123>>>>>        If (iErr) Begin
37125>>>>>            Send Clear of hoUserDD
37126>>>>>            Function_Return False
37127>>>>>        End
37127>>>>>>
37127>>>>>        
37127>>>>>        Send Request_Save of hoUserDD
37128>>>>>        Function_Return (not(Err))
37129>>>>>    End_Function
37130>>>>>    
37130>>>>>    Function IsLoggedIn Returns Boolean
37132>>>>>        String sLoginName
37132>>>>>        Boolean bLogWebSession bLoggedIn
37132>>>>>        
37132>>>>>        Get pbLogWebSession to bLogWebSession
37133>>>>>        If not bLogWebSession Begin
37135>>>>>            Forward Get IsLoggedIn to bLoggedIn
37137>>>>>            Function_Return bLoggedIn
37138>>>>>        End
37138>>>>>>
37138>>>>>        
37138>>>>>        Get psLoginName to sLoginName
37139>>>>>        
37139>>>>>        Function_Return (sLoginName <> "")
37140>>>>>    End_Function
37141>>>>>    
37141>>>>>    
37141>>>>>    //
37141>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37141>>>>>    // update properties based on the session and user data. Augment this function to update 
37141>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37141>>>>>    // the right records when this procedure is called.
37141>>>>>    //
37141>>>>>    // Params:
37141>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37141>>>>>    //
37141>>>>>    Procedure UpdateSessionProperties Boolean bClear
37143>>>>>        Handle hoUserDD
37143>>>>>        
37143>>>>>        Get phoUserDD to hoUserDD
37144>>>>>        
37144>>>>>        //  Update user properties
37144>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37146>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37147>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37148>>>>>            Set piUserRights to WebAppUser.Rights
37149>>>>>            
37149>>>>>            Send OnSessionPropertiesSet 
37150>>>>>        End
37150>>>>>>
37150>>>>>        Else Begin
37151>>>>>            Set psUsername to ""
37152>>>>>            Set psLoginName to ""
37153>>>>>            Set piUserRights to 0
37154>>>>>            
37154>>>>>            Send OnSessionPropertiesClear
37155>>>>>        End
37155>>>>>>
37155>>>>>    End_Procedure
37156>>>>>    
37156>>>>>    Procedure OnSessionPropertiesSet
37158>>>>>        //  Empty event stub
37158>>>>>    End_Procedure
37159>>>>>    
37159>>>>>    Procedure OnSessionPropertiesClear
37161>>>>>        //  Empty event stub
37161>>>>>    End_Procedure
37162>>>>>    
37162>>>>>    Procedure EndSession
37164>>>>>        Integer iErr
37164>>>>>        Boolean bLogWebSession
37164>>>>>        Handle hoSessionDD       
37164>>>>>        
37164>>>>>        Get phoSessionDD to hoSessionDD
37165>>>>>        Get pbLogWebSession to bLogWebSession
37166>>>>>        If not bLogWebSession Begin
37168>>>>>            Forward Send EndSession
37170>>>>>            Procedure_Return
37171>>>>>        End
37171>>>>>>
37171>>>>>            
37171>>>>>        //  Check if session exists
37171>>>>>        Send Clear of hoSessionDD
37172>>>>>        Get psSessionKey to WebAppSession.SessionKey
37173>>>>>        
37173>>>>>        Send Find of hoSessionDD EQ Index.1
37174>>>>>        If (Found) Begin
37176>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37177>>>>>            Get Request_Validate of hoSessionDD to iErr
37178>>>>>            If (iErr) Begin
37180>>>>>                // this should not happen. If it does its a programming error
37180>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37181>>>>>>
37181>>>>>                Procedure_Return
37182>>>>>            End
37182>>>>>>
37182>>>>>            Send Request_Save of hoSessionDD
37183>>>>>        End
37183>>>>>>
37183>>>>>    End_Procedure
37184>>>>>
37184>>>>>End_Class
37185>>>>>
