37786>>>        tWebNavigateData NavigateData
37786>>>        tWebNavigateData NavigateData
37786>>>        Boolean bHasRecord
37786>>>        Handle hoDD
37786>>>
37786>>>        Get Server to hoDD
37787>>>        Get GetNavigateData to NavigateData
37788>>>        Get HasRecord of hoDD to bHasRecord
37789>>>
37789>>>        // let's hide all buttons and then Show the ones we want
37789>>>        WebSet pbRender of oEditBtn to False
37790>>>        WebSet pbRender of oSaveBtn to False
37791>>>        WebSet pbRender of oCancelChangesBtn to False
37792>>>        WebSet pbRender of oDeleteBtn to False
37793>>>
37793>>>        If (NavigateData.bReadOnly) Begin
37795>>>            WebSet pbRender of oEditBtn to True
37796>>>        End
37796>>>>
37796>>>        Else Begin
37797>>>            WebSet pbRender of oSaveBtn to True
37798>>>            WebSet pbRender of oCancelChangesBtn to True
37799>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37800>>>        End
37800>>>>
37800>>>    End_Procedure
