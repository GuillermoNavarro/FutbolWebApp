38279>>>                // If from main, this is a propbably a main file Select to Zoom.
38279>>>                Send ShowInfoBox ("vengo de main " + Name(hoInvokingObject))
38280>>>                Case Break
38281>>>
38281>>>            Case (NavigateData.eNavigateType = nfFromParent)
38284>>>                // If from parent, this is a constrained drill down.
38284>>>                Case Break
38285>>>
38285>>>            Case (NavigateData.eNavigateType = nfFromChild)
38288>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38288>>>                Case Break
38289>>>
38289>>>            Case Else // must be nfUndefined
38289>>>
38289>>>        Case End
38289>>>
38289>>>        Send SetActionButtons
38290>>>
38290>>>    End_Procedure
38291>>>
38291>>>End_Object 
