37801>>>    Procedure SetActionButtons
37804>>>        tWebNavigateData NavigateData
37804>>>        tWebNavigateData NavigateData
37804>>>        Boolean bHasRecord
37804>>>        Handle hoDD
37804>>>
37804>>>        Get Server to hoDD
37805>>>        Get GetNavigateData to NavigateData
37806>>>        Get HasRecord of hoDD to bHasRecord
37807>>>
37807>>>        // let's hide all buttons and then Show the ones we want
37807>>>        WebSet pbRender of oEditBtn to False
37808>>>        WebSet pbRender of oSaveBtn to False
37809>>>        WebSet pbRender of oCancelChangesBtn to False
37810>>>        WebSet pbRender of oDeleteBtn to False
37811>>>
37811>>>        If (NavigateData.bReadOnly) Begin
37813>>>            WebSet pbRender of oEditBtn to True
37814>>>        End
37814>>>>
37814>>>        Else Begin
37815>>>            WebSet pbRender of oSaveBtn to True
37816>>>            WebSet pbRender of oCancelChangesBtn to True
37817>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37818>>>        End
37818>>>>
37818>>>    End_Procedure
37819>>>
