37799>>>                Case Break
37800>>>
37800>>>            Case (NavigateData.eNavigateType = nfFromParent)
37803>>>                // If from parent, this is a constrained drill down.
37803>>>                Case Break
37804>>>
37804>>>            Case (NavigateData.eNavigateType = nfFromChild)
37807>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37807>>>                Case Break
37808>>>
37808>>>            Case Else // must be nfUndefined
37808>>>
37808>>>        Case End
37808>>>
37808>>>        Send SetActionButtons
37809>>>
37809>>>    End_Procedure
