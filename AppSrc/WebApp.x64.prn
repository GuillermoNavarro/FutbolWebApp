37837>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37837>>>                Case Break
37838>>>
37838>>>            Case Else // must be nfUndefined
37838>>>
37838>>>        Case End
37838>>>
37838>>>        Send SetActionButtons
37839>>>
