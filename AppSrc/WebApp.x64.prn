37879>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37882>>>        Case Begin
37882>>>            Case (NavigateData.eNavigateType = nfFromMain)
37884>>>                // If from main, this is a propbably a main file Select to Zoom.
37884>>>                Send ShowInfoBox ("vengo de main " + Name(hoInvokingObject))
37885>>>                Case Break
37886>>>
37886>>>            Case (NavigateData.eNavigateType = nfFromParent)
37889>>>                // If from parent, this is a constrained drill down.
37889>>>                Case Break
37890>>>
37890>>>            Case (NavigateData.eNavigateType = nfFromChild)
37893>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37893>>>                Case Break
37894>>>
37894>>>            Case Else // must be nfUndefined
37894>>>
37894>>>        Case End
37894>>>
37894>>>        Send SetActionButtons
37895>>>
37895>>>    End_Procedure
37896>>>
37896>>>End_Object 
