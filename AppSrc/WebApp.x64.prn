38374>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38377>>>        Case Begin
38377>>>            Case (NavigateData.eNavigateType = nfFromMain)
38379>>>                // If from main, this is a propbably a main file Select to Zoom.
38379>>>                Send ShowInfoBox ("vengo de main " + Name(hoInvokingObject))
38380>>>                Case Break
38381>>>
38381>>>            Case (NavigateData.eNavigateType = nfFromParent)
38384>>>                // If from parent, this is a constrained drill down.
38384>>>                Case Break
38385>>>
38385>>>            Case (NavigateData.eNavigateType = nfFromChild)
38388>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38388>>>                Case Break
38389>>>
38389>>>            Case Else // must be nfUndefined
38389>>>
38389>>>        Case End
38389>>>        
38389>>>
38389>>>        Send SetActionButtons
38390>>>
38390>>>    End_Procedure
