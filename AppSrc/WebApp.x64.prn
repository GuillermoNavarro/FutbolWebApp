37707>>>                // If from main, this is a probably a main-file lookup from a Zoom
37707>>>                WebSet pbRender of oDetailButton to False
37708>>>                Case Break
37709>>>
37709>>>            Case Else // must be nfUndefined
37709>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37709>>>
37709>>>        Case End
37709>>>
37709>>>    End_Procedure
