37854>>>    Procedure SetActionButtons
37857>>>        tWebNavigateData NavigateData
37857>>>        tWebNavigateData NavigateData
37857>>>        Boolean bHasRecord
37857>>>        Handle hoDD
37857>>>
37857>>>        Get Server to hoDD
37858>>>        Get GetNavigateData to NavigateData
37859>>>        Get HasRecord of hoDD to bHasRecord
37860>>>
37860>>>        // let's hide all buttons and then Show the ones we want
37860>>>        WebSet pbRender of oEditBtn to False
37861>>>        WebSet pbRender of oSaveBtn to False
37862>>>        WebSet pbRender of oCancelChangesBtn to False
37863>>>        WebSet pbRender of oDeleteBtn to False
37864>>>
37864>>>        If (NavigateData.bReadOnly) Begin
37866>>>            WebSet pbRender of oEditBtn to True
37867>>>        End
37867>>>>
37867>>>        Else Begin
37868>>>            WebSet pbRender of oSaveBtn to True
37869>>>            WebSet pbRender of oCancelChangesBtn to True
37870>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37871>>>        End
37871>>>>
37871>>>    End_Procedure
37872>>>
37872>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37875>>>        // Close after save
37875>>>        Send NavigateClose Self
37876>>>    End_Procedure
37877>>>
37877>>>    // this will close the view after a delete
37877>>>    Procedure OnViewDeleted Handle hoDDO
37880>>>        Send NavigateClose Self
37881>>>    End_Procedure
