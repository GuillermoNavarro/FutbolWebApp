37771>>>        Get HasRecord of hoDD to bHasRecord
37772>>>
37772>>>        // let's hide all buttons and then Show the ones we want
37772>>>        WebSet pbRender of oEditBtn to False
37773>>>        WebSet pbRender of oSaveBtn to False
37774>>>        WebSet pbRender of oCancelChangesBtn to False
37775>>>        WebSet pbRender of oDeleteBtn to False
37776>>>
37776>>>        If (NavigateData.bReadOnly) Begin
37778>>>            WebSet pbRender of oEditBtn to True
37779>>>        End
37779>>>>
37779>>>        Else Begin
37780>>>            WebSet pbRender of oSaveBtn to True
37781>>>            WebSet pbRender of oCancelChangesBtn to True
37782>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37783>>>        End
37783>>>>
37783>>>    End_Procedure
