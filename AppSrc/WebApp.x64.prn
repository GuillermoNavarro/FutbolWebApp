38237>>>        tWebNavigateData NavigateData
38237>>>        tWebNavigateData NavigateData
38237>>>        Boolean bHasRecord
38237>>>        Handle hoDD
38237>>>
38237>>>        Get Server to hoDD
38238>>>        Get GetNavigateData to NavigateData
38239>>>        Get HasRecord of hoDD to bHasRecord
38240>>>
38240>>>        // let's hide all buttons and then Show the ones we want
38240>>>        WebSet pbRender of oEditBtn to False
38241>>>        WebSet pbRender of oSaveBtn to False
38242>>>        WebSet pbRender of oCancelChangesBtn to False
38243>>>        WebSet pbRender of oDeleteBtn to False
38244>>>
38244>>>        If (NavigateData.bReadOnly) Begin
38246>>>            WebSet pbRender of oEditBtn to True
38247>>>        End
38247>>>>
38247>>>        Else Begin
38248>>>            WebSet pbRender of oSaveBtn to True
38249>>>            WebSet pbRender of oCancelChangesBtn to True
38250>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38251>>>        End
38251>>>>
38251>>>    End_Procedure
