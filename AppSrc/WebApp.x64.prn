38249>>>        tWebNavigateData NavigateData
38249>>>        tWebNavigateData NavigateData
38249>>>        Boolean bHasRecord
38249>>>        Handle hoDD
38249>>>
38249>>>        Get Server to hoDD
38250>>>        Get GetNavigateData to NavigateData
38251>>>        Get HasRecord of hoDD to bHasRecord
38252>>>
38252>>>        // let's hide all buttons and then Show the ones we want
38252>>>        WebSet pbRender of oEditBtn to False
38253>>>        WebSet pbRender of oSaveBtn to False
38254>>>        WebSet pbRender of oCancelChangesBtn to False
38255>>>        WebSet pbRender of oDeleteBtn to False
38256>>>
38256>>>        If (NavigateData.bReadOnly) Begin
38258>>>            WebSet pbRender of oEditBtn to True
38259>>>        End
38259>>>>
38259>>>        Else Begin
38260>>>            WebSet pbRender of oSaveBtn to True
38261>>>            WebSet pbRender of oCancelChangesBtn to True
38262>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38263>>>        End
38263>>>>
38263>>>    End_Procedure
