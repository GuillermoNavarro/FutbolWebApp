37872>>>        tWebNavigateData NavigateData
37872>>>        tWebNavigateData NavigateData
37872>>>        Boolean bHasRecord
37872>>>        Handle hoDD
37872>>>
37872>>>        Get Server to hoDD
37873>>>        Get GetNavigateData to NavigateData
37874>>>        Get HasRecord of hoDD to bHasRecord
37875>>>
37875>>>        // let's hide all buttons and then Show the ones we want
37875>>>        WebSet pbRender of oEditBtn to False
37876>>>        WebSet pbRender of oSaveBtn to False
37877>>>        WebSet pbRender of oCancelChangesBtn to False
37878>>>        WebSet pbRender of oDeleteBtn to False
37879>>>
37879>>>        If (NavigateData.bReadOnly) Begin
37881>>>            WebSet pbRender of oEditBtn to True
37882>>>        End
37882>>>>
37882>>>        Else Begin
37883>>>            WebSet pbRender of oSaveBtn to True
37884>>>            WebSet pbRender of oCancelChangesBtn to True
37885>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37886>>>        End
37886>>>>
37886>>>    End_Procedure
