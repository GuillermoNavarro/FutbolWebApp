37801>>>        Get HasRecord of hoDD to bHasRecord
37802>>>
37802>>>        // let's hide all buttons and then Show the ones we want
37802>>>        WebSet pbRender of oEditBtn to False
37803>>>        WebSet pbRender of oSaveBtn to False
37804>>>        WebSet pbRender of oCancelChangesBtn to False
37805>>>        WebSet pbRender of oDeleteBtn to False
37806>>>
37806>>>        If (NavigateData.bReadOnly) Begin
37808>>>            WebSet pbRender of oEditBtn to True
37809>>>        End
37809>>>>
37809>>>        Else Begin
37810>>>            WebSet pbRender of oSaveBtn to True
37811>>>            WebSet pbRender of oCancelChangesBtn to True
37812>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37813>>>        End
37813>>>>
37813>>>    End_Procedure
