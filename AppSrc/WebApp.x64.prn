38242>>>        Get HasRecord of hoDD to bHasRecord
38243>>>
38243>>>        // let's hide all buttons and then Show the ones we want
38243>>>        WebSet pbRender of oEditBtn to False
38244>>>        WebSet pbRender of oSaveBtn to False
38245>>>        WebSet pbRender of oCancelChangesBtn to False
38246>>>        WebSet pbRender of oDeleteBtn to False
38247>>>
38247>>>        If (NavigateData.bReadOnly) Begin
38249>>>            WebSet pbRender of oEditBtn to True
38250>>>        End
38250>>>>
38250>>>        Else Begin
38251>>>            WebSet pbRender of oSaveBtn to True
38252>>>            WebSet pbRender of oCancelChangesBtn to True
38253>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38254>>>        End
38254>>>>
38254>>>    End_Procedure
