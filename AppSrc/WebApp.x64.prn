37834>>>                Case Break
37835>>>
37835>>>            Case (NavigateData.eNavigateType = nfFromParent)
37838>>>                // If from parent, this is a constrained drill down.
37838>>>                Case Break
37839>>>
37839>>>            Case (NavigateData.eNavigateType = nfFromChild)
37842>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37842>>>                Case Break
37843>>>
37843>>>            Case Else // must be nfUndefined
37843>>>
37843>>>        Case End
37843>>>
37843>>>        Send SetActionButtons
37844>>>
37844>>>    End_Procedure
37845>>>
37845>>>End_Object 
